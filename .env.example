PORT=8787
HOST=127.0.0.1
# Optional. When omitted, invite links use the current request host.
PUBLIC_BASE_URL=
GROUP_RELAY_DATA_DIR=./data
MAX_FILE_SIZE_MB=25
# 服务端只是中转缓冲区,客户端保存长期副本。过期的消息、附件按下面的保留期回收。
GROUP_RELAY_MESSAGE_RETENTION_DAYS=7
GROUP_RELAY_ATTACHMENT_RETENTION_HOURS=48
# 整机搬迁:设成新服务器地址,老服务器启动时把所有账号推过去并公告 movedTo,
# 客户端下次查 /health 时自己跟随。只能在这里设,没有写接口。
GROUP_RELAY_MOVED_TO=

# Used only by `npm run mcp`
GROUP_RELAY_URL=http://127.0.0.1:8787
GROUP_RELAY_GROUP_ID=
# 身份就是 email(+provider),没有成员 token。
GROUP_RELAY_EMAIL=
GROUP_RELAY_PROVIDER=
